RACHEL_HOME=.rachel

# Provider principal (normalmente local/Ollama via API OpenAI-compatible)
RACHEL_MODEL_PROVIDER=mock
RACHEL_MODEL_NAME=rachel-mock-v1
RACHEL_MODEL_BASE_URL=https://api.example.com/v1
RACHEL_MODEL_API_KEY=
RACHEL_MODEL_TIMEOUT_SECONDS=60

# Model Router. Habilitado por padrao; privacy.policy.json inicia em local-only.
RACHEL_MODEL_ROUTER_ENABLED=1
RACHEL_MODEL_PROFILES_PATH=
RACHEL_PRIVACY_POLICY_PATH=

# Provider cloud opcional. Deixe vazio para manter somente o provider principal.
RACHEL_CLOUD_MODEL_BASE_URL=
RACHEL_CLOUD_MODEL_NAME=
RACHEL_CLOUD_MODEL_API_KEY=
RACHEL_CLOUD_MODEL_TIMEOUT_SECONDS=60

RACHEL_API_HOST=127.0.0.1
RACHEL_API_PORT=8765
RACHEL_API_TOKEN=
RACHEL_LOG_LEVEL=INFO
