{
  "schema_version": "1.0",
  "maximum_file_bytes": 26214400,
  "maximum_extracted_characters": 2000000,
  "chunk_characters": 4000,
  "chunk_overlap_characters": 400,
  "allowed_extensions": [
    ".bmp",
    ".css",
    ".csv",
    ".docx",
    ".htm",
    ".html",
    ".jpeg",
    ".jpg",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".pdf",
    ".png",
    ".pptx",
    ".ps1",
    ".py",
    ".sql",
    ".tif",
    ".tiff",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".webp",
    ".xlsx",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "structured_extensions": [
    ".json",
    ".csv"
  ],
  "deny_hidden_files": false,
  "preserve_source_path": true,
  "calculate_sha256": true
}
