{
    "schema_version":  "1.0",
    "planner":  {
                    "member":  "ned",
                    "maximum_steps":  50,
                    "maximum_goal_characters":  4000,
                    "require_unique_step_ids":  true,
                    "require_known_dependencies":  true,
                    "reject_dependency_cycles":  true
                },
    "lifecycle":  [
                      "planned",
                      "awaiting_approval",
                      "ready",
                      "running",
                      "completed",
                      "failed",
                      "cancelled"
                  ],
    "effects":  {
                    "read":  {
                                 "risk":  "low",
                                 "approval_required":  false
                             },
                    "inspect":  {
                                    "risk":  "low",
                                    "approval_required":  false
                                },
                    "search":  {
                                   "risk":  "low",
                                   "approval_required":  false
                               },
                    "status":  {
                                   "risk":  "low",
                                   "approval_required":  false
                               },
                    "list":  {
                                 "risk":  "low",
                                 "approval_required":  false
                             },
                    "external":  {
                                     "risk":  "medium",
                                     "approval_required":  true
                                 },
                    "write":  {
                                  "risk":  "medium",
                                  "approval_required":  true
                              },
                    "create":  {
                                   "risk":  "medium",
                                   "approval_required":  true
                               },
                    "edit":  {
                                 "risk":  "medium",
                                 "approval_required":  true
                             },
                    "execute":  {
                                    "risk":  "high",
                                    "approval_required":  true
                                },
                    "install":  {
                                    "risk":  "high",
                                    "approval_required":  true
                                },
                    "publish":  {
                                    "risk":  "high",
                                    "approval_required":  true
                                },
                    "delete":  {
                                   "risk":  "critical",
                                   "approval_required":  true
                               },
                    "admin":  {
                                  "risk":  "critical",
                                  "approval_required":  true
                              }
                },
    "execution":  {
                      "enabled":  true,
                      "reason":  "Governed resumable executor is available.",
                      "require_cyber_authorization":  true,
                      "record_events_with_king":  true,
                      "monitor_with_jhon":  true,
                      "validate_output_with_dany":  true,
                      "resume_after_interruption":  true,
                      "persist_after_each_step":  true,
                      "skip_completed_steps":  true,
                      "continue_after_failure":  false
                  }
}
